{
  "name": "@openbox-ai/openbox-sdk",
  "version": "0.1.0",
  "description": "OpenBox TypeScript base SDK — shared governance, signing, and instrumentation behavior for Node/TS framework SDKs",
  "license": "MIT",
  "author": "OpenBox Team",
  "homepage": "https://github.com/OpenBox-AI/openbox-sdk-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenBox-AI/openbox-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/OpenBox-AI/openbox-sdk-ts/issues"
  },
  "keywords": [
    "openbox",
    "governance",
    "observability",
    "signing",
    "opentelemetry",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.10.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "ci:check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run import:check",
    "clean": "rm -rf coverage dist",
    "format": "prettier --write .",
    "import:check": "node scripts/check-root-import-light.mjs",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb": "^6.21.0",
    "mysql2": "^3.22.6",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "redis": "^4.7.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
